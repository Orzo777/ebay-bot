# ---------------------------------------------------------------------------
# Скопіюйте цей файл у .env і заповніть значення:
#   cp .env.example .env        (Windows: copy .env.example .env)
# Якщо частину ключів не заповнити — бот працює в dry-run (mock-дані + консоль).
# ---------------------------------------------------------------------------

# --- eBay Production keys ---------------------------------------------------
# developer.ebay.com -> Hi <you> -> Application Keysets -> Production
# App ID = "Client ID", Cert ID = "Client Secret"
EBAY_APP_ID=
EBAY_CERT_ID=

# Маркетплейс: передається як заголовок X-EBAY-C-MARKETPLACE-ID у кожен запит.
# EBAY_DE (Німеччина, EUR) за замовчуванням. Інші: EBAY_AT, EBAY_GB, EBAY_US, ...
EBAY_MARKETPLACE_ID=EBAY_DE
CURRENCY=EUR

# --- Telegram ------------------------------------------------------------------
# Токен від @BotFather (виглядає як 123456789:AA....)
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (число). Як дізнатися — див. README.
TELEGRAM_CHAT_ID=

# --- Виявлення аномалій (необов'язкові) --------------------------------------
# Аномалія = ціна нижча за ANOMALY_THRESHOLD * ІСТОРИЧНА медіана ціни для epid
ANOMALY_THRESHOLD=0.6
# Скільки спостережень треба накопичити для epid, перш ніж почати порівнювати
MIN_HISTORY_POINTS=3
# Вікно історії: медіана рахується лише по точках за останні N днів
HISTORY_WINDOW_DAYS=14
# Ігнорувати лоти дешевші за MIN_PRICE
MIN_PRICE=5.0

# --- Фільтр стану через API (не через слова) --------------------------------
# 1000 New | 1500 New other | 1750 New with defects
# 2000 Certified refurbished | 2500 Seller refurbished
# (3000/4000/5000/6000 Used* і 7000 For parts свідомо НЕ включені)
SEARCH_CONDITION_IDS=1000|1500|1750|2000|2500

# --- Фільтр репутації продавця ----------------------------------------------
MIN_SELLER_FEEDBACK_SCORE=10
MIN_SELLER_FEEDBACK_PCT=95.0

# --- Сигнал ліквідності (наближений proxy з власного полінгу) ----------------
# Вікно для метрик попиту
LIQUIDITY_WINDOW_DAYS=30
# Доки epid відстежується менше — вердикт UNKNOWN (ручна перевірка обов'язкова)
MIN_LIQUIDITY_TRACK_DAYS=10
# Завершень циклу лістингів для виходу зі стану UNKNOWN
MIN_LIQUIDITY_EVENTS=3
LIQ_HIGH_PER_WEEK=1.5
LIQ_LOW_PER_WEEK=0.5
LIQ_FAST_DAYS=12
LIQ_SLOW_DAYS=25
# Скільки активних пропозицій при ~0 продажів = "затоварення" (LOW)
SUPPLY_GLUT_MIN=5
# Скільки днів відсутності у видачі = лістинг зник
LISTING_GONE_AFTER_DAYS=2

# Виявлення перевиставлення (relist): той самий продавець, схожа назва+ціна за
# кілька днів — це не продаж, не рахується у швидкість
RELIST_WINDOW_DAYS=5
RELIST_PRICE_TOLERANCE=0.06
RELIST_TITLE_SIMILARITY=0.7

# Провайдер оцінки ліквідності: порожньо = власний proxy;
# on/1/true = Marketplace Insights API (потребує App Check ticket від eBay)
MARKETPLACE_INSIGHTS_ENABLED=

# --- Режим розвідки (discovery) --------------------------------------------
# true (за замовч.): збираємо дані по широкому списку категорій, кандидати
#   пишуться в discovery_log.jsonl, у Telegram НІЧОГО не шлеться.
# Через ~DISCOVERY_PERIOD_DAYS: `python main.py --discovery-report`, звузити
#   CATEGORIES у config.py до найкращих за score, поставити тут false.
DISCOVERY_MODE=true
DISCOVERY_PERIOD_DAYS=7
DISCOVERY_LOG_FILE=discovery_log.jsonl
DISCOVERY_REPORT_FILE=discovery_report.md

# Інтервал полінгу за замовчуванням для `--interval` без значення.
# 1800с → 48 циклів/добу. Бюджет: 2 виклики × 34 категорії × 48 = 3264/добу
# (≈ 65% від ліміту eBay 5000/добу).
POLL_INTERVAL_SECONDS=1800

# Розмір відповіді Browse API (limit) для обох запитів A/B. 200 — максимум API;
# на бюджет не впливає (це один виклик незалежно від розміру).
SEARCH_LIMIT=200

# --- Мережа (необов'язкові) --------------------------------------------------
HTTP_TIMEOUT=20
MAX_RETRIES=4
BACKOFF_BASE=2.0

# Файл: історія цін + життєвий цикл лістингів + надіслані item_id + мапа epid
PRICE_HISTORY_FILE=price_history.json
